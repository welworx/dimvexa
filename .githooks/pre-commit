#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# Fast checks before a commit, the same ones CI runs (the real gate):
#   1. gitleaks:           a secret (API key, token, private key) in the staged changes
#   2. typos:              spelling in the staged files
#   3. taplo fmt --check:  formatting of the staged .toml files
#   4. Rust, when .rs or Cargo files are staged: cargo fmt --check, clippy -D warnings and a
#      cargo check on the minimum supported Rust version (the checks CI would fail on)
# Enable once per clone:  git config core.hooksPath .githooks
# Install the tools:      go install github.com/zricethezav/gitleaks/v8@v8.30.1
#                         cargo install typos-cli taplo-cli --locked
# A tool that is not installed is reported and skipped, never a reason to block the commit.
# The checks read the files in your working tree, which may differ from what is staged.
# Bypass once with `git commit --no-verify` (CI still runs every check). Never bypass it to get
# a red commit onto a PR: fix the failure.
set -u

fail=0

# --- 1. secrets -------------------------------------------------------------------------------
gl="$(command -v gitleaks 2>/dev/null || true)"
if [ -z "$gl" ] && command -v go >/dev/null 2>&1; then
  candidate="$(go env GOPATH)/bin/gitleaks"
  [ -x "$candidate" ] && gl="$candidate"
fi
if [ -z "$gl" ]; then
  echo "pre-commit: gitleaks is not installed, so this commit was NOT scanned for secrets." >&2
  echo "pre-commit: install it:  go install github.com/zricethezav/gitleaks/v8@v8.30.1" >&2
  echo "pre-commit: CI will scan the pushed history either way." >&2
else
  "$gl" git --pre-commit --staged --redact --no-banner || fail=1
fi

# Staged files that still exist after the commit (added, copied, modified, renamed).
if git diff --cached --quiet --diff-filter=ACMR; then
  exit "$fail"
fi

# --- 2. spelling ------------------------------------------------------------------------------
if command -v typos >/dev/null 2>&1; then
  # --force-exclude keeps the exclusions of typos.toml for files that are named explicitly.
  git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 typos --force-exclude -- || fail=1
else
  echo "pre-commit: typos is not installed, so spelling was NOT checked (cargo install typos-cli --locked)." >&2
fi

# --- 3. TOML format ---------------------------------------------------------------------------
if git diff --cached --quiet --diff-filter=ACMR -- '*.toml'; then
  :
elif command -v taplo >/dev/null 2>&1; then
  git diff --cached --name-only --diff-filter=ACMR -z -- '*.toml' | xargs -0 taplo fmt --check -- || fail=1
else
  echo "pre-commit: taplo is not installed, so TOML format was NOT checked (cargo install taplo-cli --locked)." >&2
fi

# --- 4. Rust: format, lints and the MSRV (what `cargo xtask ci fmt clippy msrv` runs) ---------
if git diff --cached --quiet --diff-filter=ACMR -- '*.rs' 'Cargo.toml' '*/Cargo.toml' 'Cargo.lock'; then
  :
elif command -v cargo >/dev/null 2>&1; then
  cargo xtask ci fmt clippy msrv || fail=1
else
  echo "pre-commit: cargo is not installed, so fmt, clippy and the MSRV build were NOT checked." >&2
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: a check failed; fix it, or bypass once with --no-verify (CI runs the same checks)." >&2
fi
exit "$fail"
