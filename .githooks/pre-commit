#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# Blocks a commit that adds a secret (API key, token, private key) to the repository.
# Enable once per clone:  git config core.hooksPath .githooks
# Install the scanner:    go install github.com/zricethezav/gitleaks/v8@v8.30.1
#                         (or your package manager; any recent gitleaks 8.x works)
# CI scans the full history with the same tool and is the real gate; this hook only catches
# a leak before it leaves your machine. Bypass once with `git commit --no-verify` (CI still scans).
set -eu

gl="$(command -v gitleaks 2>/dev/null || true)"
if [ -z "$gl" ] && command -v go >/dev/null 2>&1; then
  candidate="$(go env GOPATH)/bin/gitleaks"
  [ -x "$candidate" ] && gl="$candidate"
fi

if [ -z "$gl" ]; then
  echo "pre-commit: gitleaks is not installed, so this commit was NOT scanned for secrets." >&2
  echo "pre-commit: install it:  go install github.com/zricethezav/gitleaks/v8@v8.30.1" >&2
  echo "pre-commit: CI will scan the pushed history either way." >&2
  exit 0
fi

exec "$gl" git --pre-commit --staged --redact --no-banner
