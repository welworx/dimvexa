{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dimvexa.configs/2",
  "title": "dimvexa.configs/2",
  "description": "Output of `dimvexa configs --json`: the configs that ship with dimvexa, or what one config (a shipped name or a file path) contains, or a usage error. Adding fields is allowed within a schema version; removing or changing them requires a new version. Exact numbers are strings so no JSON parser rounds them (ADR-014). /2 replaces /1 (ADR-018): the `densities` entries became `constants` (a `[[constant]]` of any unit, with `unit`, `exactness` and an optional `codata` edition), and the counts in the list are `constants`.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "ok",
        "configs"
      ],
      "properties": {
        "schema": {
          "const": "dimvexa.configs/2"
        },
        "ok": {
          "const": true
        },
        "configs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "hash",
              "mappings",
              "units",
              "constants"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "hash": {
                "type": "string",
                "pattern": "^fnv1a64:[0-9a-f]{16}$"
              },
              "mappings": {
                "type": "integer",
                "minimum": 0
              },
              "units": {
                "type": "integer",
                "minimum": 0
              },
              "constants": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "ok",
        "config"
      ],
      "properties": {
        "schema": {
          "const": "dimvexa.configs/2"
        },
        "ok": {
          "const": true
        },
        "config": {
          "type": "object",
          "required": [
            "name",
            "hash",
            "mappings",
            "units",
            "constants"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "`bundled:NAME` for a shipped config, else the path as given."
            },
            "hash": {
              "type": "string",
              "pattern": "^fnv1a64:[0-9a-f]{16}$"
            },
            "mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "unit",
                  "line"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "units": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "symbol",
                  "base",
                  "factor",
                  "exactness",
                  "source",
                  "line"
                ],
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "base": {
                    "type": "string"
                  },
                  "factor": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(/[0-9]+)?$"
                  },
                  "exactness": {
                    "enum": [
                      "defined",
                      "measured"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "constants": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "value",
                  "unit",
                  "exactness",
                  "codata",
                  "conditions",
                  "source",
                  "note",
                  "file",
                  "line"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The identifier the user selects (never also a unit's name)."
                  },
                  "name": {
                    "type": "string",
                    "description": "The full name, for example `Planck constant`. Never empty.",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^([0-9]+(/[0-9]+)?)?( ?10\\^-?[0-9]+)?( ?pi(\\^-?[0-9]+)?)?$",
                    "description": "The exact value: a fraction, optionally followed by 10^k and pi^m (for example `662607015 10^-42`)."
                  },
                  "unit": {
                    "type": "string",
                    "description": "The unit expression the value is a number of; it gives the dimension."
                  },
                  "exactness": {
                    "enum": [
                      "defined",
                      "measured"
                    ]
                  },
                  "codata": {
                    "type": "string",
                    "description": "Pinned CODATA edition of a measured value; may be empty."
                  },
                  "conditions": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "dimvexa.configs/2"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "suggestions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
