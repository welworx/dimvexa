{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dimvexa.convert/1",
  "title": "dimvexa.convert/1",
  "description": "Output of `dimvexa convert --json`. Adding fields is allowed within a schema version; removing or changing them requires /2. Exact numbers are strings so no JSON parser rounds them.",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema", "ok", "input", "output", "exact", "exactness", "dimension", "kind", "quantity_kind", "profile", "packs", "data_version", "sources"],
      "properties": {
        "schema": { "const": "dimvexa.convert/1" },
        "ok": { "const": true },
        "input": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": { "value": { "type": "string" }, "unit": { "type": "string" } }
        },
        "output": {
          "type": "object",
          "required": ["value", "unit", "f64", "truncated"],
          "properties": {
            "value": { "type": "string", "description": "Decimal expansion of the exact result, at most 15 fraction digits." },
            "unit": { "type": "string" },
            "f64": { "type": "number", "description": "The exact result rounded once to the nearest f64." },
            "truncated": { "type": "boolean", "description": "True if value was cut at 15 fraction digits." }
          }
        },
        "exact": {
          "type": "object",
          "required": ["value", "factor", "offset"],
          "properties": {
            "value": { "type": "string", "pattern": "^-?[0-9]+/[0-9]+$" },
            "factor": { "type": "string", "pattern": "^-?[0-9]+/[0-9]+$" },
            "offset": { "type": "string", "pattern": "^-?[0-9]+/[0-9]+$" }
          }
        },
        "exactness": { "enum": ["defined", "measured"] },
        "dimension": { "type": "array", "items": { "type": "integer" }, "minItems": 7, "maxItems": 7, "description": "Exponents of kg, m, s, A, K, mol, cd." },
        "kind": { "enum": ["linear", "affine"], "description": "Conversion shape (named `kind` in the plan's sketch; see quantity_kind for the quantity kind)." },
        "quantity_kind": { "enum": ["plain", "absolute_temperature", "temperature_difference"] },
        "profile": { "type": ["string", "null"] },
        "packs": { "type": "array", "items": { "type": "string" } },
        "data_version": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    {
      "type": "object",
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "dimvexa.convert/1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": ["parse_error", "invalid_number", "unknown_unit", "ambiguous_symbol", "ambiguous_expression", "dimension_mismatch", "kind_mismatch", "overflow", "division_by_zero", "length_mismatch", "refused", "invalid_definition", "duplicate_symbol", "usage"],
              "description": "Library error codes (stable, non-exhaustive list) plus `usage` for command-line mistakes."
            },
            "message": { "type": "string" },
            "candidates": { "type": "array", "items": { "type": "string" }, "description": "Explicit symbols or close matches (ambiguous_symbol, unknown_unit)." },
            "suggestions": { "type": "array", "items": { "type": "string" }, "description": "Everything the error recommends instead: candidates, or the delta unit (delta_K, delta_degC, ...) for temperature kind errors and refused offset units." }
          }
        }
      }
    }
  ]
}
