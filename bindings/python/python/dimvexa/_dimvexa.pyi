from typing import Any, Optional, Sequence

__version__: str

class DimvexaError(ValueError):
    code: str
    suggestions: list[str]
    candidates: list[str]

class Conversion:
    @property
    def shape(self) -> str: ...
    @property
    def factor(self) -> str: ...
    @property
    def offset(self) -> str: ...
    def __call__(self, x: Any) -> Any: ...
    def apply_exact(self, x: float) -> float: ...
    def inverse(self) -> "Conversion": ...

class Quantity:
    @property
    def value(self) -> str: ...
    @property
    def unit(self) -> str: ...
    def to(self, unit: str) -> "Quantity": ...
    def to_float(self) -> float: ...
    def __add__(self, other: "Quantity") -> "Quantity": ...
    def __sub__(self, other: "Quantity") -> "Quantity": ...
    def __mul__(self, other: "Quantity") -> "Quantity": ...
    def __truediv__(self, other: "Quantity") -> "Quantity": ...

def convert(value: Any, from_unit: str, to_unit: str, *, exact: bool = False) -> Any: ...
def conversion(from_unit: str, to_unit: str) -> Conversion: ...
def quantity(text: str) -> Quantity: ...
def units() -> list[str]: ...
def unit_info(symbol: str) -> Optional[dict[str, Any]]: ...
def data_version() -> str: ...
